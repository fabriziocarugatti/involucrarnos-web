# ─── Brevo (newsletter) ────────────────────────────────────
BREVO_API_KEY=your_brevo_api_key_here
BREVO_LIST_ID=your_list_id_number_here

# ─── OpenRouter (IA chat — "El Especialista") ──────────────
# Crear cuenta gratis en https://openrouter.ai/keys
# Modelo usado: deepseek/deepseek-chat-v3-0324:free (chino, gratis)
OPENROUTER_API_KEY=sk-or-v1-...

# ─── Sanity CMS (admin de artículos) ───────────────────────
# Crear proyecto gratis en https://sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
# Token con write permission (solo para revalidación)
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=random_long_string_here
